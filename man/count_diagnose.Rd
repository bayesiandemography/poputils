   \code{finite} \tab \code{Inf} or \code{-Inf} \cr
   \code{nonneg} \tab less than 0 \cr
   \code{le_one} \tab greater than 1 \cr
   \code{no_zero} \tab equal to 0 \cr
   \code{no_one} \tab equal to 1 \cr
   \code{whole} \tab not a whole number \cr
}
